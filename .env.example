# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# --- Redfish client (real BMC or mock) ---
REDFISH_BASE_URL=http://127.0.0.1:8000
REDFISH_USERNAME=
REDFISH_PASSWORD=
# true for production BMCs with valid certs; false only for lab/self-signed setups
REDFISH_VERIFY_TLS=true
REDFISH_TIMEOUT=5

# --- Mock Redfish server ---
# Scenario name from config/mock_scenarios.yaml (normal | sensor_warning | host_gpu_failure | powered_off | vendor_ids)
MOCK_SCENARIO=normal
# If both are set the mock enforces HTTP Basic auth on /redfish/v1/* (service root stays public, as in Redfish)
MOCK_REDFISH_USERNAME=
MOCK_REDFISH_PASSWORD=
